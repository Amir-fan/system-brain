# KIP Next environment template
# Copy to .env.local or .env and fill with real values outside git.

# Supabase (new KIP Next project)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Temporary bootstrap platform-admin credential for the provider-management slice.
# NOT the final KIP Admin auth architecture. Env-only, server-side, never logged,
# never stored in the DB, never returned to the frontend.
KIP_PLATFORM_ADMIN_TOKEN=

# OpenRouter initial provider (optional: reduces live provider tests). Platform-level;
# the primary admin-path stores the key in Supabase Vault.
OPENROUTER_API_KEY=

# Default model for OpenRouter invocation.
MODEL_NAME=openrouter/auto